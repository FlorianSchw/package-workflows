{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "successCmd": "git tag -f v${nextRelease.version.split('.')[0]} ${nextRelease.gitHead} && git push -f origin v${nextRelease.version.split('.')[0]}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "draftRelease": false,
        "successComment": false,
        "failComment": false,
        "failTitle": false,
        "releasedLabels": false
      }
    ]
  ]
}
